# PLOT 12: Market Stability Metric Correlation Matrix
# ==============================================================================
def plot_12_stability_correlation_matrix(df):
    """Plot correlation heatmap across price boundaries, spreads, and volatility indicators."""
    metrics_df = df[['Min_Price', 'Max_Price', 'Modal_Price', 'Price_Spread', 'Price_Spread_Pct', 'Spread_Ratio']].dropna()
    metrics_df.columns = [
        'Min Price (₹)',
        'Max Price (₹)',
        'Modal Price (₹)',
        'Absolute Spread (₹)',
        'Spread Pct (%)',
        'Spread Ratio (Max/Min)'
    ]
    
    corr_matrix = metrics_df.corr(method='pearson')
    
    plt.figure(figsize=(10, 8))
    mask = np.triu(np.ones_like(corr_matrix, dtype=bool))
    
    sns.heatmap(
        corr_matrix,
        mask=mask,
        annot=True,
        fmt='.2f',
        cmap='coolwarm',
        vmin=-0.5,
        vmax=1.0,
        center=0,
        linewidths=0.8,
        linecolor='white',
        cbar_kws={'label': 'Pearson Correlation Coefficient ($r$)'},
        annot_kws={'size': 10.5, 'fontweight': 'bold'}
    )
    
    plt.title("Figure 12: Market Stability Correlation Matrix\nInterrelationship Between Price Discovery Metrics and Spread Volatility",
              fontsize=13, fontweight='bold', pad=15)
    plt.xticks(rotation=30, ha='right', fontsize=9.5)
    plt.yticks(fontsize=9.5)
    plt.tight_layout()
    output_path = os.path.join(OUTPUT_DIR, '12_market_stability_index_matrix.png')
    plt.savefig(output_path, dpi=300, bbox_inches='tight')
    plt.close()
    print(f"Saved: {output_path}")

