# PLOT 2: Dual-Axis Price Trend vs. Volatility Spread Percentage
# ==============================================================================
def plot_02_dual_axis_trend(df):
    """Plot dual-axis comparison: Modal Price (Left) vs. Volatility Spread % (Right)."""
    top_comm = df['Commodity'].value_counts().head(12).index
    summary = df[df['Commodity'].isin(top_comm)].groupby('Commodity', observed=True).agg(
        Mean_Modal=('Modal_Price', 'mean'),
        Mean_Spread_Pct=('Price_Spread_Pct', 'mean'),
        Sample_Count=('Modal_Price', 'count')
    ).sort_values('Mean_Modal', ascending=False).reset_index()
    
    fig, ax1 = plt.subplots(figsize=(15, 7))
    
    x = np.arange(len(summary))
    width = 0.45
    
    # Primary Axis: Mean Modal Price (Bar chart)
    bars = ax1.bar(x, summary['Mean_Modal'], width=width, color='#2b5c8f', alpha=0.85,
                   label='Average Modal Price (₹/Quintal)', edgecolor='#173f5f', linewidth=1)
    ax1.set_xlabel('Agricultural Commodity', fontsize=12, fontweight='bold', labelpad=10)
    ax1.set_ylabel('Average Modal Price (₹/Quintal)', fontsize=12, fontweight='bold', color='#173f5f')
    ax1.tick_params(axis='y', labelcolor='#173f5f')
    ax1.set_xticks(x)
    ax1.set_xticklabels(summary['Commodity'], rotation=35, ha='right', fontsize=10, fontweight='semibold')
    
    # Annotate bar values
    for bar in bars:
        h = bar.get_height()
        ax1.annotate(f'₹{h:.0f}',
                     xy=(bar.get_x() + bar.get_width() / 2, h),
                     xytext=(0, 4), textcoords="offset points",
                     ha='center', va='bottom', fontsize=8.5, fontweight='bold', color='#173f5f')
    
    # Secondary Axis: Price Spread Percentage (Line chart)
    ax2 = ax1.twinx()
    line = ax2.plot(x, summary['Mean_Spread_Pct'], color='#e65100', marker='o', linewidth=2.8,
                    markersize=8, label='Volatility Spread % ((Max-Min)/Modal)', zorder=5)
    ax2.set_ylabel('Mean Price Spread % (Intra-Market Volatility)', fontsize=12, fontweight='bold', color='#e65100')
    ax2.tick_params(axis='y', labelcolor='#e65100')
    ax2.grid(False)
    
    # Annotate line points
    for i, val in enumerate(summary['Mean_Spread_Pct']):
        ax2.annotate(f'{val:.1f}%',
                     xy=(x[i], val),
                     xytext=(0, 8), textcoords="offset points",
                     ha='center', va='bottom', fontsize=9, fontweight='bold', color='#b23c00')
        
    lines1, labels1 = ax1.get_legend_handles_labels()
    lines2, labels2 = ax2.get_legend_handles_labels()
    ax1.legend(lines1 + lines2, labels1 + labels2, loc='upper right', frameon=True,
               facecolor='white', framealpha=0.95, fontsize=10)
    
    plt.title("Figure 2: Dual-Axis Price Trend & Volatility Spread Percentage\nComparing Wholesale Price Levels with Intra-Market Daily Price Dispersion",
              fontsize=14, fontweight='bold', pad=15)
    plt.tight_layout()
    output_path = os.path.join(OUTPUT_DIR, '02_dual_axis_price_and_spread_trend.png')
    plt.savefig(output_path, dpi=300, bbox_inches='tight')
    plt.close()
    print(f"Saved: {output_path}")

